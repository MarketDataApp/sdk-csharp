<?xml version="1.0" encoding="utf-8" ?>
<!--
  Run settings for Coverlet XPlat Code Coverage data collector.
  Pass to dotnet test via:
    dotnet test -collect:"XPlat Code Coverage" -settings coverlet.runsettings
-->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <!-- Output in both OpenCover (for most CI tools) and JSON (for local diffs) -->
          <Format>opencover,json</Format>

          <!-- Exclude test assemblies from coverage measurement -->
          <Exclude>[MarketDataApp.Tests]*,[MarketDataApp.IntegrationTests]*</Exclude>

          <!-- Ignore generated build artefacts -->
          <ExcludeByFile>**/obj/**,**/bin/**</ExcludeByFile>

          <!-- Record the first hit only — false means count all hits -->
          <SingleHit>false</SingleHit>

          <!-- Do not measure coverage within test assemblies themselves -->
          <IncludeTestAssembly>false</IncludeTestAssembly>

          <!-- Emit Source Link-aware paths so coverage tools map back to source -->
          <UseSourceLink>true</UseSourceLink>

          <!-- Coverage policy (§13/§15): 100% total line AND branch coverage.
               NOTE: coverlet.collector (this data collector) does NOT enforce these
               values — they are declared here to document the policy and to map back
               to source. The gate that actually FAILS the build is coverlet.msbuild
               via `-p:Threshold=100 -p:ThresholdType=line,branch -p:ThresholdStat=total`
               in .github/workflows/ci.yml. -->
          <Threshold>100</Threshold>
          <ThresholdType>line,branch</ThresholdType>
          <ThresholdStat>total</ThresholdStat>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
