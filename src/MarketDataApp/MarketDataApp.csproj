<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Both current LTS releases (§14 asks CI to cover multiple runtime versions; net8 is
         also the broadest installed base). -->
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MarketDataApp</RootNamespace>
    <AssemblyName>MarketDataApp</AssemblyName>
    <UserSecretsId>ffbff63c-6a0f-451d-94a2-71dc2cdd91f9</UserSecretsId>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!-- Package metadata -->
    <!-- The NuGet package ID is deliberately NOT the assembly name. The assembly and
         root namespace stay MarketDataApp (that is what `using MarketDataApp;` binds to
         and what already ships in the XML docs); the package published to nuget.org is
         marketdata.sdk, which matches the sibling SDKs' marketdata-sdk-* naming and
         avoids colliding with the MarketDataApp organization name on nuget.org.
         Package IDs are immutable once published — changing this after the first
         release means abandoning an ID, not renaming it. -->
    <PackageId>marketdata.sdk</PackageId>
    <Authors>MarketData.app, Exceptal</Authors>
    <Copyright>© 2026 Market Data — originally created by Omid Rad (Exceptal)</Copyright>
    <Description>RELEASE CANDIDATE. C#/.NET SDK for the marketdata.app API. Provides asynchronous access to real-time and historical financial data including stocks, options, funds, and market status.</Description>
    <PackageReleaseNotes>Release candidate for 1.0.0. The public API is feature-complete and no breaking changes are planned before the stable release; report any problems against this candidate. Install with --prerelease until 1.0.0 is published.</PackageReleaseNotes>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/MarketDataApp/sdk-csharp</PackageProjectUrl>
    <RepositoryUrl>https://github.com/MarketDataApp/sdk-csharp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>finance;market-data;stocks;options;api;marketdata</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IsPackable>true</IsPackable>

    <!-- Versioning is git-tag-driven via MinVer (no hand-maintained <Version> literal).
         Release tags look like v1.2.3; MinVerTagPrefix=v maps them to package version
         1.2.3. With no tags present (local/dev), MinVer emits a 0.0.0-alpha.0.N
         pre-release, so `dotnet build`/`dotnet pack` still succeed offline. The runtime
         User-Agent reads AssemblyInformationalVersion, which MinVer also sets. -->
    <MinVerTagPrefix>v</MinVerTagPrefix>

    <!-- Symbols package (snupkg) -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>

    <!-- Reproducible / deterministic builds -->
    <Deterministic>true</Deterministic>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>

    <!-- Package validation — checks API surface consistency across both target frameworks -->
    <EnablePackageValidation>true</EnablePackageValidation>
  </PropertyGroup>

  <!-- Source Link and CI-deterministic builds run in CI only.
       Locally, this machine's git remote uses an SSH host alias that Source Link
       cannot resolve, which emits "Source control information is not available -
       the generated source link is empty". Gating on GITHUB_ACTIONS keeps local
       `dotnet build` at zero warnings while CI (normal clones with an https remote)
       still produces full Source Link and ContinuousIntegrationBuild output. -->
  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!-- Ship the repository README (NuGet package readme) and the LICENSE file inside the
       package. PackageLicenseExpression above declares the SPDX license id; the file itself
       must also travel in the distribution per the SDK packaging requirements. -->
  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="/" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="/" />
  </ItemGroup>

  <!-- Grant the unit-test assembly access to internal transport/parsing helpers so their
       defensive branches (null-argument guards, service-key edge cases, formatting helpers)
       can be exercised as real behavior tests rather than excluded from coverage. This changes
       no runtime behavior. -->
  <ItemGroup>
    <InternalsVisibleTo Include="MarketDataApp.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DotNetEnv" Version="3.2.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" Version="10.0.11" />
    <!-- Provides AddHttpClient / IHttpClientFactory for the DI extensions (transitively pulls in
         Microsoft.Extensions.DependencyInjection.Abstractions). -->
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
    <!-- Provides the built-in console logging provider and ConsoleFormatter base type for the
         opt-in AddMarketDataCanonicalConsole() / MarketDataConsoleFormatter canonical log layout. -->
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.11" />
    <!-- MinVer: derives the package/assembly version from git tags at build time. -->
    <PackageReference Include="MinVer" Version="7.0.0" PrivateAssets="All" />
  </ItemGroup>

  <!-- Source Link: embeds source file URIs in the PDB for debugger step-through.
       CI-only — see the ContinuousIntegrationBuild note above for why. -->
  <ItemGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.400" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <None Update=".env">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update=".env.example">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
